<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        This build asks for NO permissions on purpose. It only reads what Android hands to any app:
        package metadata for packages declared below (package visibility, Android 11+), and files the user
        explicitly picks through the system file picker.

        QUERY_ALL_PACKAGES is deliberately not requested. To detect a store variant with another package id,
        add it here (and to KnownPackages.kt) rather than widening visibility.
    -->
    <queries>
        <package android:name="com.chucklefish.stardewvalley" />
        <!-- Existing community SMAPI launcher (documented package id); detected read-only for conflict diagnostics. -->
        <package android:name="abc.smapi.gameloader" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
